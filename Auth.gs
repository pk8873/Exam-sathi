function hashPassword_(password,salt){var bytes=Utilities.newBlob(salt+password).getBytes();for(var i=0;i<12000;i++)bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes);return Utilities.base64EncodeWebSafe(bytes);}
function validEmail_(s){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s||''));}
function clean_(s,max){return String(s||'').trim().slice(0,max||160);}
function registerStudent_(p){var name=clean_(p.name,100),email=clean_(p.email,160).toLowerCase(),mobile=clean_(p.mobile,15),pass=String(p.password||''),guardian=clean_(p.guardianName,100),gm=clean_(p.guardianMobile,15);if(name.length<2||!validEmail_(email)||!/^[6-9]\d{9}$/.test(mobile)||pass.length<10||!guardian||!/^[6-9]\d{9}$/.test(gm)||p.consent!==true)throw new Error('सभी जानकारी सही भरें। Password कम से कम 10 characters और parent consent जरूरी है।');var lock=LockService.getScriptLock();lock.waitLock(10000);try{if(rows_('Users').some(function(u){return u.Email.toLowerCase()===email||u.Mobile===mobile;}))throw new Error('Email या mobile पहले से registered है।');var uid=id_('USR'),salt=Utilities.getUuid();insert_('Users',{ID:uid,Name:name,Email:email,Mobile:mobile,PasswordHash:hashPassword_(pass,salt),Salt:salt,Role:'STUDENT',Status:'Active',CreatedAt:now_()});var sid=id_('STD');insert_('Students',{ID:sid,UserID:uid,Name:name,Mobile:mobile,GuardianName:guardian,GuardianMobile:gm,Consent:'YES',Village:clean_(p.village,100),CreatedAt:now_(),Status:'Active'});insert_('Consent',{ID:id_('CON'),StudentID:sid,GuardianName:guardian,GuardianMobile:gm,ConsentGiven:'YES',RecordedAt:now_()});audit_(uid,'STUDENT_REGISTER','Students',sid);return{ok:true,message:'Registration successful. अब login करें।'};}finally{lock.releaseLock();}}
function login_(p){var email=clean_(p.email,160).toLowerCase(),password=String(p.password||''),key='LOGIN_'+Utilities.base64EncodeWebSafe(email).slice(0,50),cache=CacheService.getScriptCache(),tries=Number(cache.get(key)||0);if(tries>=8)throw new Error('बहुत अधिक प्रयास। 15 मिनट बाद फिर कोशिश करें।');var u=rows_('Users').filter(function(x){return x.Email.toLowerCase()===email&&x.Status==='Active';})[0];if(!u||hashPassword_(password,u.Salt)!==u.PasswordHash){cache.put(key,String(tries+1),900);throw new Error('Email या password गलत है।');}cache.remove(key);var token=Utilities.getUuid()+Utilities.getUuid(),session={userId:u.ID,role:u.Role,name:u.Name,email:u.Email};cache.put('SESSION_'+hashToken_(token),JSON.stringify(session),21600);update_('Users',u.ID,{LastLogin:now_()});return{ok:true,token:token,user:{name:u.Name,role:u.Role,email:u.Email}};}
function hashToken_(t){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(t))).slice(0,40);}
function session_(p,roles){var t=String(p.token||'');if(!t)throw new Error('Please login.');var raw=CacheService.getScriptCache().get('SESSION_'+hashToken_(t));if(!raw)throw new Error('Session expired. Login again.');var s=JSON.parse(raw);if(roles&&roles.indexOf(s.role)<0)throw new Error('Permission denied.');return s;}
function me_(p){var s=session_(p);return{ok:true,user:{name:s.name,email:s.email,role:s.role}};}
function logout_(p){var t=String(p.token||'');if(t)CacheService.getScriptCache().remove('SESSION_'+hashToken_(t));return{ok:true};}
function bootstrapFirstAdmin(email,password){email=clean_(email,160).toLowerCase();password=String(password||'');if(!validEmail_(email)||password.length<14)throw new Error('Valid email and 14+ character password required.');var props=PropertiesService.getScriptProperties();if(props.getProperty('ADMIN_BOOTSTRAPPED')==='YES')throw new Error('Admin already bootstrapped.');if(rows_('Users').some(function(u){return u.Role==='ADMIN';}))throw new Error('An admin already exists.');var salt=Utilities.getUuid();insert_('Users',{ID:id_('USR'),Name:'Administrator',Email:email,Mobile:'',PasswordHash:hashPassword_(password,salt),Salt:salt,Role:'ADMIN',Status:'Active',CreatedAt:now_()});props.setProperty('ADMIN_BOOTSTRAPPED','YES');audit_('SYSTEM','BOOTSTRAP_ADMIN','Users',email);return'Admin account created. Remove this setup function only after successful login if desired.';}
