function doGet(e){var p=(e&&e.parameter)||{};if(p.asset==='manifest'){return ContentService.createTextOutput(JSON.stringify({name:'Exam Saathi',short_name:'Exam Saathi',start_url:ScriptApp.getService().getUrl(),display:'standalone',background_color:'#f5f8fc',theme_color:'#102a56',description:'Exam day travel coordination'})).setMimeType(ContentService.MimeType.JSON);}return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Exam Saathi | Exam Day Travel').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function api(action,payload){try{payload=payload||{};switch(action){case'publicData':return publicData_();case'register':return registerStudent_(payload);case'login':return login_(payload);case'logout':return logout_(payload);case'me':return me_(payload);case'studentData':return studentData_(payload);case'createBooking':return createBooking_(payload);case'cancelBooking':return cancelBooking_(payload);case'adminData':return adminData_(payload);case'adminSave':return adminSave_(payload);case'adminStatus':return adminStatus_(payload);case'adminAssignTrip':return adminAssignTrip_(payload);case'adminPayment':return adminPayment_(payload);case'adminCreateDriver':return adminCreateDriver_(payload);case'driverData':return driverData_(payload);case'driverTripStatus':return driverTripStatus_(payload);default:throw new Error('Unknown request.');}}catch(err){return {ok:false,message:err.message||'Unexpected server error.'};}}
function setupDatabase(){var ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Open this script from the target Google Sheet (Extensions > Apps Script).');Object.keys(SCHEMA).forEach(function(n){var sh=ss.getSheetByName(n)||ss.insertSheet(n);var h=SCHEMA[n];if(sh.getLastRow()===0)sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold').setBackground('#eaf1fb');else{var got=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),h.length)).getValues()[0].slice(0,h.length);if(h.some(function(v,i){return got[i]!==v;}))throw new Error('Header mismatch in '+n+'. Do not overwrite data; repair headers manually.');}sh.setFrozenRows(1);});var props=PropertiesService.getScriptProperties();props.setProperty('DB_ID',ss.getId());if(!props.getProperty('COORD_FEE'))props.setProperty('COORD_FEE','30');if(!props.getProperty('SITE_NAME'))props.setProperty('SITE_NAME','Exam Saathi');return 'Database ready: '+Object.keys(SCHEMA).join(', ');}
function db_(){var id=PropertiesService.getScriptProperties().getProperty('DB_ID');if(!id)throw new Error('Database not initialized. Run setupDatabase() first.');return SpreadsheetApp.openById(id);}
function rows_(name){var sh=db_().getSheetByName(name);if(!sh)throw new Error('Missing sheet '+name);var v=sh.getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(function(r){return r[0]!=='';}).map(function(r){var o={};SCHEMA[name].forEach(function(k,i){o[k]=r[i] instanceof Date?r[i].toISOString():r[i];});return o;});}
function insert_(name,obj){var sh=db_().getSheetByName(name);var row=SCHEMA[name].map(function(k){return obj[k]===undefined?'':obj[k];});sh.appendRow(row);return obj;}
function update_(name,id,patch){var sh=db_().getSheetByName(name),v=sh.getDataRange().getValues(),idx=SCHEMA[name].indexOf('ID');for(var i=1;i<v.length;i++){if(String(v[i][idx])===String(id)){Object.keys(patch).forEach(function(k){var c=SCHEMA[name].indexOf(k);if(c>=0)v[i][c]=patch[k];});sh.getRange(i+1,1,1,SCHEMA[name].length).setValues([v[i].slice(0,SCHEMA[name].length)]);return true;}}throw new Error('Record not found.');}
function id_(prefix){return prefix+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase();}
function now_(){return new Date().toISOString();}
function audit_(actor,action,entity,detail){insert_('AuditLogs',{ID:id_('LOG'),ActorID:actor||'SYSTEM',Action:action,Entity:entity,Detail:String(detail||'').slice(0,500),CreatedAt:now_()});}
function publicData_(){return{ok:true,siteName:PropertiesService.getScriptProperties().getProperty('SITE_NAME')||'Exam Saathi',fee:Number(PropertiesService.getScriptProperties().getProperty('COORD_FEE')||30),exams:rows_('Exams').filter(function(x){return x.Status==='Active';}),centres:rows_('ExamCenters').filter(function(x){return x.Status==='Active';}),routes:rows_('Routes').filter(function(x){return x.Status==='Active';})};}
function healthCheck(){var s=db_();return{spreadsheet:s.getName(),sheets:Object.keys(SCHEMA).map(function(n){return{name:n,rows:Math.max(0,s.getSheetByName(n).getLastRow()-1)};})};}
