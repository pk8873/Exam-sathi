function studentData_(p){var s=session_(p,['STUDENT']),st=rows_('Students').filter(function(x){return x.UserID===s.userId;})[0];if(!st)throw new Error('Student profile not found.');return{ok:true,student:st,bookings:rows_('Bookings').filter(function(b){return b.StudentID===st.ID;}).map(enrichBooking_),notifications:rows_('Notifications').filter(function(n){return n.UserID===s.userId;}).slice(-20).reverse(),public:publicData_()};}
function enrichBooking_(b){var r=rows_('Routes').filter(function(x){return x.ID===b.RouteID;})[0]||{},c=rows_('ExamCenters').filter(function(x){return x.ID===b.CentreID;})[0]||{},e=rows_('Exams').filter(function(x){return x.ID===b.ExamID;})[0]||{};return Object.assign({},b,{Route:r,Centre:c,Exam:e});}
function createBooking_(p){var s=session_(p,['STUDENT']),lock=LockService.getScriptLock();lock.waitLock(10000);try{var st=rows_('Students').filter(function(x){return x.UserID===s.userId&&x.Status==='Active';})[0];if(!st||st.Consent!=='YES')throw new Error('Guardian consent required.');var exam=rows_('Exams').filter(function(x){return x.ID===p.examId&&x.Status==='Active';})[0],route=rows_('Routes').filter(function(x){return x.ID===p.routeId&&x.Status==='Active';})[0];if(!exam||!route)throw new Error('Exam or route unavailable.');if(new Date(exam.Deadline)<new Date())throw new Error('Booking deadline has passed.');if(rows_('Bookings').some(function(b){return b.StudentID===st.ID&&b.ExamID===exam.ID&&b.Status!=='Cancelled'&&b.Status!=='Rejected';}))throw new Error('You already have an active booking for this exam.');var centre=rows_('ExamCenters').filter(function(c){return c.ID===route.CentreID;})[0];if(!centre)throw new Error('Exam centre not found.');var fare=Number(route.Fare),fee=Number(PropertiesService.getScriptProperties().getProperty('COORD_FEE')||30);if(!isFinite(fare)||fare<0)throw new Error('Invalid route fare.');var b={ID:id_('BKG'),StudentID:st.ID,ExamID:exam.ID,CentreID:centre.ID,RouteID:route.ID,PickupPoint:route.PickupPoint,VehicleFare:fare,CoordinationFee:fee,TotalAmount:fare+fee,Status:'Pending',TripID:'',CreatedAt:now_(),UpdatedAt:now_(),PaymentStatus:'Pending'};insert_('Bookings',b);notify_(s.userId,'Booking received','आपकी booking '+b.ID+' प्राप्त हुई है।');audit_(s.userId,'BOOKING_CREATE','Bookings',b.ID);return{ok:true,message:'Booking request submitted.',bookingId:b.ID};}finally{lock.releaseLock();}}
function cancelBooking_(p){var s=session_(p,['STUDENT']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0],st=rows_('Students').filter(function(x){return x.UserID===s.userId;})[0];if(!b||!st||b.StudentID!==st.ID)throw new Error('Booking not found.');if(['Pending','Under Review'].indexOf(b.Status)<0)throw new Error('Confirmed/assigned booking cancellation के लिए support से संपर्क करें।');update_('Bookings',b.ID,{Status:'Cancelled',UpdatedAt:now_()});return{ok:true};}
function notify_(uid,title,msg){insert_('Notifications',{ID:id_('NTF'),UserID:uid,Title:title,Message:msg,Read:'NO',CreatedAt:now_()});}
function adminData_(p){session_(p,['ADMIN']);return{ok:true,stats:stats_(),students:rows_('Students'),drivers:rows_('Drivers'),vehicles:rows_('Vehicles'),exams:rows_('Exams'),centres:rows_('ExamCenters'),routes:rows_('Routes'),bookings:rows_('Bookings').map(enrichBooking_),trips:rows_('Trips'),payments:rows_('Payments'),settings:{fee:PropertiesService.getScriptProperties().getProperty('COORD_FEE')||'30',name:PropertiesService.getScriptProperties().getProperty('SITE_NAME')||'Exam Saathi'}};}
function stats_(){var b=rows_('Bookings'),p=rows_('Payments');return{students:rows_('Students').length,bookings:b.length,pending:b.filter(function(x){return x.Status==='Pending'||x.Status==='Under Review';}).length,confirmed:b.filter(function(x){return x.Status==='Confirmed'||x.Status==='Driver Assigned';}).length,drivers:rows_('Drivers').filter(function(x){return x.Status==='Active'&&x.VerificationStatus==='Verified';}).length,vehicles:rows_('Vehicles').filter(function(x){return x.Status==='Active'&&x.VerificationStatus==='Verified';}).length,revenue:p.filter(function(x){return x.Status==='Received';}).reduce(function(a,x){return a+Number(x.Amount||0);},0)};}
function adminSave_(p){var s=session_(p,['ADMIN']),table=p.table,rec=p.record||{},allowed={Exams:['Name','ExamDate','ReportingTime','StartTime','EndTime','Deadline','Status'],ExamCenters:['Name','Address','District','MapsUrl','Contact','Status'],Routes:['Village','PickupPoint','CentreID','DistanceKm','DurationMin','Fare','Status'],Vehicles:['DriverID','RegistrationNo','Type','Capacity','InsuranceExpiry','PermitExpiry','FitnessExpiry','VerificationStatus','Status']};if(!allowed[table])throw new Error('Unsupported module.');var cleanRec={};allowed[table].forEach(function(k){if(rec[k]!==undefined)cleanRec[k]=clean_(rec[k],k==='Address'?300:160);});if(table==='Routes'&&(!cleanRec.Village||!cleanRec.PickupPoint||!cleanRec.CentreID||Number(cleanRec.Fare)<0))throw new Error('Route details invalid.');if(table==='Vehicles'&&(!cleanRec.RegistrationNo||Number(cleanRec.Capacity)<1||Number(cleanRec.Capacity)>20))throw new Error('Vehicle details invalid.');if(rec.ID){update_(table,rec.ID,cleanRec);audit_(s.userId,'UPDATE',table,rec.ID);}else{cleanRec.ID=id_(table.slice(0,3).toUpperCase());if(table==='Routes')cleanRec.Status=cleanRec.Status||'Active';if(table==='Vehicles')cleanRec.VerificationStatus='Pending';insert_(table,cleanRec);audit_(s.userId,'CREATE',table,cleanRec.ID);}return{ok:true};}
function adminStatus_(p){var s=session_(p,['ADMIN']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0];if(!b)throw new Error('Booking not found.');var allowed=['Under Review','Confirmed','Rejected','Cancelled'];if(allowed.indexOf(p.status)<0)throw new Error('Invalid status.');update_('Bookings',b.ID,{Status:p.status,UpdatedAt:now_()});var st=rows_('Students').filter(function(x){return x.ID===b.StudentID;})[0];if(st)notify_(st.UserID,'Booking update','आपकी booking '+b.ID+' का status: '+p.status);audit_(s.userId,'BOOKING_STATUS','Bookings',b.ID+' => '+p.status);return{ok:true};}
function adminCreateDriver_(p){var s=session_(p,['ADMIN']),d=p.driver||{},email=clean_(d.email,160).toLowerCase(),pass=String(d.password||'');if(!validEmail_(email)||pass.length<12||!d.name||!/^[6-9]\d{9}$/.test(String(d.mobile||'')))throw new Error('Driver name, valid email/mobile and 12+ character password required.');if(rows_('Users').some(function(u){return u.Email.toLowerCase()===email;}))throw new Error('Email already exists.');var salt=Utilities.getUuid(),uid=id_('USR');insert_('Users',{ID:uid,Name:clean_(d.name,100),Email:email,Mobile:d.mobile,PasswordHash:hashPassword_(pass,salt),Salt:salt,Role:'DRIVER',Status:'Active',CreatedAt:now_()});insert_('Drivers',{ID:id_('DRV'),UserID:uid,Name:clean_(d.name,100),Mobile:d.mobile,LicenseNumber:clean_(d.license,50),VerificationStatus:'Pending',Status:'Active',CreatedAt:now_()});audit_(s.userId,'DRIVER_CREATE','Drivers',email);return{ok:true,message:'Driver account created; verification is pending.'};}
function driverData_(p){var s=session_(p,['DRIVER']),d=rows_('Drivers').filter(function(x){return x.UserID===s.userId;})[0];if(!d)throw new Error('Driver profile missing.');var trips=rows_('Trips').filter(function(t){return t.DriverID===d.ID;}).map(function(t){var v=rows_('Vehicles').filter(function(x){return x.ID===t.VehicleID;})[0]||{},r=rows_('Routes').filter(function(x){return x.ID===t.RouteID;})[0]||{},c=rows_('ExamCenters').filter(function(x){return x.ID===r.CentreID;})[0]||{},pass=rows_('TripStudents').filter(function(x){return x.TripID===t.ID;}).map(function(x){var st=rows_('Students').filter(function(z){return z.ID===x.StudentID;})[0]||{};return{Name:st.Name,GuardianMobile:st.GuardianMobile};});return Object.assign({},t,{Vehicle:v,Route:r,Centre:c,Passengers:pass});});return{ok:true,driver:d,trips:trips};}
function driverTripStatus_(p){var s=session_(p,['DRIVER']),d=rows_('Drivers').filter(function(x){return x.UserID===s.userId;})[0],t=rows_('Trips').filter(function(x){return x.ID===p.tripId&&x.DriverID===d.ID;})[0];if(!t)throw new Error('Trip not assigned to this driver.');if(['Ready','Started','Completed','Cancelled'].indexOf(p.status)<0)throw new Error('Invalid trip status.');update_('Trips',t.ID,{Status:p.status});if(p.status==='Completed')rows_('TripStudents').filter(function(x){return x.TripID===t.ID;}).forEach(function(x){update_('Bookings',x.BookingID,{Status:'Completed',UpdatedAt:now_()});});audit_(s.userId,'TRIP_STATUS','Trips',t.ID+' => '+p.status);return{ok:true};}
