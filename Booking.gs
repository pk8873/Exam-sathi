function studentData_(p){var s=session_(p,['STUDENT']),st=rows_('Students').filter(function(x){return x.UserID===s.userId;})[0];if(!st)throw new Error('Student profile not found.');return{ok:true,student:st,bookings:rows_('Bookings').filter(function(b){return b.StudentID===st.ID;}).map(enrichBooking_),notifications:rows_('Notifications').filter(function(n){return n.UserID===s.userId;}).slice(-20).reverse(),public:publicData_()};}
function enrichBooking_(b){var r=rows_('Routes').filter(function(x){return x.ID===b.RouteID;})[0]||{},c=rows_('ExamCenters').filter(function(x){return x.ID===b.CentreID;})[0]||{},e=rows_('Exams').filter(function(x){return x.ID===b.ExamID;})[0]||{};return Object.assign({},b,{Route:r,Centre:c,Exam:e});}
function createBooking_(p){var s=session_(p,['STUDENT']),lock=LockService.getScriptLock();lock.waitLock(10000);try{var st=rows_('Students').filter(function(x){return x.UserID===s.userId&&x.Status==='Active';})[0];if(!st||st.Consent!=='YES')throw new Error('Guardian consent required.');var exam=rows_('Exams').filter(function(x){return x.ID===p.examId&&x.Status==='Active';})[0],route=rows_('Routes').filter(function(x){return x.ID===p.routeId&&x.Status==='Active';})[0];if(!exam||!route)throw new Error('Exam or route unavailable.');if(new Date(exam.Deadline)<new Date())throw new Error('Booking deadline has passed.');if(rows_('Bookings').some(function(b){return b.StudentID===st.ID&&b.ExamID===exam.ID&&b.Status!=='Cancelled'&&b.Status!=='Rejected';}))throw new Error('You already have an active booking for this exam.');var centre=rows_('ExamCenters').filter(function(c){return c.ID===route.CentreID;})[0];if(!centre)throw new Error('Exam centre not found.');var fare=Number(route.Fare),fee=Number(PropertiesService.getScriptProperties().getProperty('COORD_FEE')||30);if(!isFinite(fare)||fare<0)throw new Error('Invalid route fare.');var b={ID:id_('BKG'),StudentID:st.ID,ExamID:exam.ID,CentreID:centre.ID,RouteID:route.ID,PickupPoint:route.PickupPoint,VehicleFare:fare,CoordinationFee:fee,TotalAmount:fare+fee,Status:'Pending',TripID:'',CreatedAt:now_(),UpdatedAt:now_(),PaymentStatus:'Pending'};insert_('Bookings',b);notify_(s.userId,'Booking received','आपकी booking '+b.ID+' प्राप्त हुई है।');audit_(s.userId,'BOOKING_CREATE','Bookings',b.ID);return{ok:true,message:'Booking request submitted.',bookingId:b.ID};}finally{lock.releaseLock();}}
function cancelBooking_(p){var s=session_(p,['STUDENT']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0],st=rows_('Students').filter(function(x){return x.UserID===s.userId;})[0];if(!b||!st||b.StudentID!==st.ID)throw new Error('Booking not found.');if(['Pending','Under Review'].indexOf(b.Status)<0)throw new Error('Confirmed/assigned booking cancellation के लिए support से संपर्क करें।');update_('Bookings',b.ID,{Status:'Cancelled',UpdatedAt:now_()});return{ok:true};}
function notify_(uid,title,msg){insert_('Notifications',{ID:id_('NTF'),UserID:uid,Title:title,Message:msg,Read:'NO',CreatedAt:now_()});}
function adminData_(p){session_(p,['ADMIN']);return{ok:true,stats:stats_(),students:rows_('Students'),drivers:rows_('Drivers'),vehicles:rows_('Vehicles'),exams:rows_('Exams'),centres:rows_('ExamCenters'),routes:rows_('Routes'),bookings:rows_('Bookings').map(enrichBooking_),trips:rows_('Trips'),payments:rows_('Payments'),settings:{fee:PropertiesService.getScriptProperties().getProperty('COORD_FEE')||'30',name:PropertiesService.getScriptProperties().getProperty('SITE_NAME')||'Exam Saathi'}};}
function stats_(){var b=rows_('Bookings'),p=rows_('Payments');return{students:rows_('Students').length,bookings:b.length,pending:b.filter(function(x){return x.Status==='Pending'||x.Status==='Under Review';}).length,confirmed:b.filter(function(x){return x.Status==='Confirmed'||x.Status==='Driver Assigned';}).length,drivers:rows_('Drivers').filter(function(x){return x.Status==='Active'&&x.VerificationStatus==='Verified';}).length,vehicles:rows_('Vehicles').filter(function(x){return x.Status==='Active'&&x.VerificationStatus==='Verified';}).length,revenue:p.filter(function(x){return x.Status==='Received';}).reduce(function(a,x){return a+Number(x.Amount||0);},0)};}
function adminSave_(p){var s=session_(p,['ADMIN']),table=p.table,rec=p.record||{},allowed={Exams:['Name','ExamDate','ReportingTime','StartTime','EndTime','Deadline','Status'],ExamCenters:['Name','Address','District','MapsUrl','Contact','Status'],Routes:['Village','PickupPoint','CentreID','DistanceKm','DurationMin','Fare','Status'],Vehicles:['DriverID','RegistrationNo','Type','Capacity','InsuranceExpiry','PermitExpiry','FitnessExpiry','VerificationStatus','Status']};if(!allowed[table])throw new Error('Unsupported module.');var cleanRec={};allowed[table].forEach(function(k){if(rec[k]!==undefined)cleanRec[k]=clean_(rec[k],k==='Address'?300:160);});if(table==='Routes'&&(!cleanRec.Village||!cleanRec.PickupPoint||!cleanRec.CentreID||Number(cleanRec.Fare)<0))throw new Error('Route details invalid.');if(table==='Vehicles'&&(!cleanRec.RegistrationNo||Number(cleanRec.Capacity)<1||Number(cleanRec.Capacity)>20))throw new Error('Vehicle details invalid.');if(rec.ID){update_(table,rec.ID,cleanRec);audit_(s.userId,'UPDATE',table,rec.ID);}else{cleanRec.ID=id_(table.slice(0,3).toUpperCase());if(['Routes','Vehicles','Exams','ExamCenters'].indexOf(table)>=0)cleanRec.Status=cleanRec.Status||'Active';if(table==='Vehicles')cleanRec.VerificationStatus='Pending';insert_(table,cleanRec);audit_(s.userId,'CREATE',table,cleanRec.ID);}return{ok:true};}
function adminStatus_(p){var s=session_(p,['ADMIN']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0];if(!b)throw new Error('Booking not found.');var allowed=['Under Review','Confirmed','Rejected','Cancelled'];if(allowed.indexOf(p.status)<0)throw new Error('Invalid status.');update_('Bookings',b.ID,{Status:p.status,UpdatedAt:now_()});var st=rows_('Students').filter(function(x){return x.ID===b.StudentID;})[0];if(st)notify_(st.UserID,'Booking update','आपकी booking '+b.ID+' का status: '+p.status);audit_(s.userId,'BOOKING_STATUS','Bookings',b.ID+' => '+p.status);return{ok:true};}
function adminCreateDriver_(p){var s=session_(p,['ADMIN']),d=p.driver||{},email=clean_(d.email,160).toLowerCase(),pass=String(d.password||'');if(!validEmail_(email)||pass.length<12||!d.name||!/^[6-9]\d{9}$/.test(String(d.mobile||'')))throw new Error('Driver name, valid email/mobile and 12+ character password required.');if(rows_('Users').some(function(u){return u.Email.toLowerCase()===email;}))throw new Error('Email already exists.');var salt=Utilities.getUuid(),uid=id_('USR');insert_('Users',{ID:uid,Name:clean_(d.name,100),Email:email,Mobile:d.mobile,PasswordHash:hashPassword_(pass,salt),Salt:salt,Role:'DRIVER',Status:'Active',CreatedAt:now_()});insert_('Drivers',{ID:id_('DRV'),UserID:uid,Name:clean_(d.name,100),Mobile:d.mobile,LicenseNumber:clean_(d.license,50),VerificationStatus:'Pending',Status:'Active',CreatedAt:now_()});audit_(s.userId,'DRIVER_CREATE','Drivers',email);return{ok:true,message:'Driver account created; verification is pending.'};}
function driverData_(p){var s=session_(p,['DRIVER']),d=rows_('Drivers').filter(function(x){return x.UserID===s.userId;})[0];if(!d)throw new Error('Driver profile missing.');var trips=rows_('Trips').filter(function(t){return t.DriverID===d.ID;}).map(function(t){var v=rows_('Vehicles').filter(function(x){return x.ID===t.VehicleID;})[0]||{},r=rows_('Routes').filter(function(x){return x.ID===t.RouteID;})[0]||{},c=rows_('ExamCenters').filter(function(x){return x.ID===r.CentreID;})[0]||{},pass=rows_('TripStudents').filter(function(x){return x.TripID===t.ID;}).map(function(x){var st=rows_('Students').filter(function(z){return z.ID===x.StudentID;})[0]||{};return{Name:st.Name};});return Object.assign({},t,{Vehicle:v,Route:r,Centre:c,Passengers:pass});});return{ok:true,driver:d,trips:trips};}
function driverTripStatus_(p){var s=session_(p,['DRIVER']),d=rows_('Drivers').filter(function(x){return x.UserID===s.userId;})[0],t=rows_('Trips').filter(function(x){return x.ID===p.tripId&&x.DriverID===d.ID;})[0];if(!t)throw new Error('Trip not assigned to this driver.');if(['Ready','Started','Completed','Cancelled'].indexOf(p.status)<0)throw new Error('Invalid trip status.');update_('Trips',t.ID,{Status:p.status});if(p.status==='Completed')rows_('TripStudents').filter(function(x){return x.TripID===t.ID;}).forEach(function(x){update_('Bookings',x.BookingID,{Status:'Completed',UpdatedAt:now_()});});audit_(s.userId,'TRIP_STATUS','Trips',t.ID+' => '+p.status);return{ok:true};}


function adminAssignTrip_(p){var s=session_(p,['ADMIN']),ids=Array.isArray(p.bookingIds)?p.bookingIds.map(String):[];if(!ids.length)throw new Error('Select at least one booking.');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var bs=ids.map(function(id){return rows_('Bookings').filter(function(b){return b.ID===id;})[0];});if(bs.some(function(b){return !b;}))throw new Error('A selected booking no longer exists.');var first=bs[0];if(bs.some(function(b){return b.Status!=='Pending'&&b.Status!=='Under Review'&&b.Status!=='Confirmed';}))throw new Error('Only pending/review/confirmed bookings can be assigned.');if(bs.some(function(b){return b.RouteID!==first.RouteID||b.ExamID!==first.ExamID||b.CentreID!==first.CentreID;}))throw new Error('All selected bookings must share the same route and exam.');if(new Set(bs.map(function(b){return b.StudentID;})).size!==bs.length)throw new Error('Duplicate student selection.');var driver=rows_('Drivers').filter(function(x){return x.ID===p.driverId&&x.Status==='Active'&&x.VerificationStatus==='Verified';})[0];var vehicle=rows_('Vehicles').filter(function(x){return x.ID===p.vehicleId&&x.Status==='Active'&&x.VerificationStatus==='Verified';})[0];if(!driver||!vehicle)throw new Error('Driver and vehicle must both be verified and active.');if(vehicle.DriverID!==driver.ID)throw new Error('Selected vehicle is not registered to this driver.');if(bs.length>Number(vehicle.Capacity))throw new Error('Seat capacity exceeded. Selected '+bs.length+'; capacity '+vehicle.Capacity+'.');if(bs.some(function(b){return b.TripID;}))throw new Error('A booking is already assigned to a trip.');var trip={ID:id_('TRP'),RouteID:first.RouteID,ExamID:first.ExamID,DriverID:driver.ID,VehicleID:vehicle.ID,PickupTime:clean_(p.pickupTime,40),Status:'Assigned',CreatedAt:now_()};insert_('Trips',trip);bs.forEach(function(b){insert_('TripStudents',{ID:id_('TST'),TripID:trip.ID,BookingID:b.ID,StudentID:b.StudentID,CreatedAt:now_()});update_('Bookings',b.ID,{TripID:trip.ID,Status:'Driver Assigned',UpdatedAt:now_()});var st=rows_('Students').filter(function(x){return x.ID===b.StudentID;})[0];if(st)notify_(st.UserID,'Driver assigned','Trip '+trip.ID+' assigned. Pickup time: '+trip.PickupTime);});audit_(s.userId,'TRIP_ASSIGN','Trips',trip.ID+' bookings='+ids.length);return{ok:true,tripId:trip.ID,message:'Trip assigned to '+ids.length+' student(s).'};}finally{lock.releaseLock();}}
function adminPayment_(p){var s=session_(p,['ADMIN']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0];if(!b)throw new Error('Booking not found.');var amount=Number(p.amount),method=clean_(p.method,20),status=clean_(p.status,20);if(!isFinite(amount)||amount<0||amount>b.TotalAmount)throw new Error('Payment amount invalid.');if(['Cash','UPI'].indexOf(method)<0||['Pending','Received','Refund Requested','Refunded'].indexOf(status)<0)throw new Error('Invalid payment method/status.');if(status==='Received'&&method==='UPI'&&!clean_(p.reference,100))throw new Error('UPI reference is required.');insert_('Payments',{ID:id_('PAY'),BookingID:b.ID,Amount:amount,Method:method,Reference:clean_(p.reference,100),Status:status,RefundStatus:'None',RecordedBy:s.userId,CreatedAt:now_()});update_('Bookings',b.ID,{PaymentStatus:status==='Received'?'Received':'Pending',UpdatedAt:now_()});audit_(s.userId,'PAYMENT_RECORD','Payments',b.ID+' '+amount+' '+status);return{ok:true};}


function adminVerify_(p){var s=session_(p,['ADMIN']),table=p.table,id=clean_(p.id,80),status=p.status;if(status!=='Verified'&&status!=='Rejected')throw new Error('Invalid verification status.');if(table==='Drivers'){update_('Drivers',id,{VerificationStatus:status});}else if(table==='Vehicles'){update_('Vehicles',id,{VerificationStatus:status});}else throw new Error('Unsupported verification target.');audit_(s.userId,'VERIFY_'+status,table,id);return{ok:true};}


function receipt_(p){var sess=session_(p,['ADMIN','STUDENT']),b=rows_('Bookings').filter(function(x){return x.ID===p.bookingId;})[0];if(!b)throw new Error('Booking not found.');if(sess.role==='STUDENT'){var st=rows_('Students').filter(function(x){return x.UserID===sess.userId;})[0];if(!st||st.ID!==b.StudentID)throw new Error('Permission denied.');}var ex=rows_('Exams').filter(function(x){return x.ID===b.ExamID;})[0]||{},rt=rows_('Routes').filter(function(x){return x.ID===b.RouteID;})[0]||{},ce=rows_('ExamCenters').filter(function(x){return x.ID===b.CentreID;})[0]||{},student=rows_('Students').filter(function(x){return x.ID===b.StudentID;})[0]||{};var html='<html><body style="font-family:Arial;padding:28px;color:#17243a"><h1 style="color:#102a56">Exam Saathi</h1><p>Booking receipt · '+b.ID+'</p><hr><h2>'+clean_(student.Name,100)+'</h2><p>Exam: '+clean_(ex.Name,150)+' · Date: '+clean_(ex.ExamDate,30)+'</p><p>Centre: '+clean_(ce.Name,150)+' — '+clean_(ce.Address,250)+'</p><p>Village: '+clean_(rt.Village,100)+' · Pickup: '+clean_(rt.PickupPoint,150)+'</p><hr><table width="100%"><tr><td>Vehicle fare</td><td align="right">₹'+b.VehicleFare+'</td></tr><tr><td>Coordination fee</td><td align="right">₹'+b.CoordinationFee+'</td></tr><tr><th>Total payable</th><th align="right">₹'+b.TotalAmount+'</th></tr></table><p>Status: '+b.Status+' · Payment: '+b.PaymentStatus+'</p><p style="color:#667">This is a booking coordination receipt, not a tax invoice or proof of completed transport.</p></body></html>';var blob=HtmlService.createHtmlOutput(html).getBlob().getAs(MimeType.PDF).setName('Exam-Saathi-'+b.ID+'.pdf');return{ok:true,name:blob.getName(),base64:Utilities.base64Encode(blob.getBytes())};}
